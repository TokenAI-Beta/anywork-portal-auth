{
  "name": "anywork-portal-auth",
  "version": "0.2.27",
  "private": false,
  "description": "Anywork 门户登录。安装并重启后出现登录门户，并拉起 admin001。",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/state.js",
    "lib/update.js",
    "lib/client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "demo"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "demo": "echo Open demo/index.html in a browser (file:// or static serve)"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TokenAI-Beta/anywork-portal-auth.git"
  }
}
